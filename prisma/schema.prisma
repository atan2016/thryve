generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TEACHER
  ADMIN
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  FAILED
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String
  role           Role
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  teacher        Teacher?
  wallet         CreditWallet?
  bookings       Booking[]        @relation("CustomerBookings")
  transactions   CreditTransaction[]
}

model Teacher {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  slug                  String                 @unique
  fullName              String
  city                  String
  serviceRadiusMiles    Int
  training              String
  experienceYears       Int
  bio                   String
  gender                String
  certificationStatus   String
  published             Boolean                @default(false)
  user                  User                   @relation(fields: [userId], references: [id])
  badges                TeacherBadge[]
  styles                TeacherStyle[]
  stories               TeacherStory[]
  offerings             TeacherOffering[]
  availabilitySlots     AvailabilitySlot[]
  bookings              Booking[]              @relation("TeacherBookings")
  teachingHourCounters  TeachingHourCounter[]
  earnings              TeacherEarningsLedger[]
  payoutAccount         TeacherPayoutAccount?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Badge {
  id          String        @id @default(cuid())
  name        String        @unique
  description String
  teachers    TeacherBadge[]
}

model TeacherBadge {
  id         String   @id @default(cuid())
  teacherId  String
  badgeId    String
  verified   Boolean  @default(false)
  proofUrl   String?
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  badge      Badge    @relation(fields: [badgeId], references: [id])
  @@unique([teacherId, badgeId])
}

model YogaStyle {
  id          String         @id @default(cuid())
  name        String         @unique
  teachers    TeacherStyle[]
}

model TeacherStyle {
  id         String    @id @default(cuid())
  teacherId  String
  styleId    String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  style      YogaStyle @relation(fields: [styleId], references: [id])
  @@unique([teacherId, styleId])
}

model ServiceCategory {
  id          String            @id @default(cuid())
  slug        String            @unique
  label       String
  offerings   TeacherOffering[]
  counters    TeachingHourCounter[]
}

model TeacherOffering {
  id               String         @id @default(cuid())
  teacherId        String
  categoryId       String
  title            String
  description      String
  deliveryMode     DeliveryMode
  sessionLengthMin Int
  creditPrice      Int
  active           Boolean        @default(true)
  teacher          Teacher        @relation(fields: [teacherId], references: [id])
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings         Booking[]
}

model TeacherStory {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  caption     String
  mediaUrl    String
  mediaType   String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

model AvailabilitySlot {
  id          String    @id @default(cuid())
  teacherId   String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  isBooked    Boolean   @default(false)
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
}

model Booking {
  id             String         @id @default(cuid())
  customerId     String
  teacherId      String
  offeringId     String
  slotId         String
  notes          String?
  status         BookingStatus
  paymentStatus  PaymentStatus
  startsAt       DateTime
  endsAt         DateTime
  creditsSpent   Int
  customer       User           @relation("CustomerBookings", fields: [customerId], references: [id])
  teacher        Teacher        @relation("TeacherBookings", fields: [teacherId], references: [id])
  offering       TeacherOffering @relation(fields: [offeringId], references: [id])
  createdAt      DateTime       @default(now())
}

model CreditWallet {
  id            String              @id @default(cuid())
  userId        String              @unique
  balance       Int                 @default(0)
  user          User                @relation(fields: [userId], references: [id])
  transactions  CreditTransaction[]
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  walletId    String
  amount      Int
  type        String
  reference   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  wallet      CreditWallet @relation(fields: [walletId], references: [id])
}

model TeacherEarningsLedger {
  id                 String       @id @default(cuid())
  teacherId          String
  bookingId          String       @unique
  grossCredits       Int
  platformCommission Int
  netCredits         Int
  payoutStatus       PayoutStatus
  payoutBatchRef     String?
  teacher            Teacher      @relation(fields: [teacherId], references: [id])
}

model TeacherPayoutAccount {
  id                  String   @id @default(cuid())
  teacherId           String   @unique
  provider            String?
  providerAccountId   String?
  onboardingComplete  Boolean  @default(false)
  teacher             Teacher  @relation(fields: [teacherId], references: [id])
}

model TeachingHourCounter {
  id           String          @id @default(cuid())
  teacherId    String
  categoryId   String
  totalHours   Int             @default(0)
  teacher      Teacher         @relation(fields: [teacherId], references: [id])
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  @@unique([teacherId, categoryId])
}
