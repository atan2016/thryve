generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Use a direct (non–connection-pooler) URL for migrations on Supabase; see https://pris.ly/d/supabase
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  TEACHER
  ADMIN
}

enum DiscussionAuthorRole {
  MEMBER
  TEACHER
  ADMIN
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

enum CertificationSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PendingSignupStatus {
  PENDING
  VERIFIED
  CONSUMED
  EXPIRED
  CANCELLED
}

model User {
  id               String                @id
  email            String                @unique
  password         String
  role             Role
  name             String
  emailVerifiedAt  DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  teacher          Teacher?
  pendingEmailChanges PendingUserEmailChange[]
  teacherFollows   UserTeacherFollow[]
  teacherHearts    UserTeacherHeart[]
  eventHostFollows UserEventHostFollow[]
}

model Teacher {
  id                       String                        @id
  userId                   String?                       @unique
  claimEmail               String?                       @unique
  slug                     String                        @unique
  fullName                 String
  avatarUrl                String?
  studioName               String?
  studioWebsiteUrl         String?
  studioScheduleUrl        String?
  websiteUrl               String?
  linkedinUrl              String?
  instagramUrl             String?
  facebookUrl              String?
  resumeUrl                String?
  resumeFileName           String?
  resumeMimeType           String?
  profileImportConsent     Boolean                       @default(false)
  profileImportRequestedAt DateTime?
  profileImportCompletedAt DateTime?
  profileImportStatus      String?
  profileImportNotes       String?
  platformHoursBooked      Int?
  city                     String
  serviceRadiusMiles       Int
  training                 String
  experienceYears          Int
  bio                      String
  gender                   String
  certificationStatus      String
  showPublicCalendar       Boolean                       @default(true)
  published                Boolean                       @default(false)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  user                     User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  stories                  TeacherStory[]
  teachingHours            TeachingHourCounter[]
  upcomingEvents           TeacherUpcomingEvent[]
  calendarSessions         TeacherCalendarSession[]
  contactInquiries         ContactInquiry[]
  certificationSubmissions TeacherCertificationSubmission[]
  followers                UserTeacherFollow[]
  hearts                   UserTeacherHeart[]
}

model PendingSignup {
  id                         String                @id
  email                      String
  normalizedEmail            String
  name                       String
  passwordHash               String
  role                       Role
  nextPath                   String?
  teacherWebsiteUrl          String?
  teacherLinkedinUrl         String?
  teacherInstagramUrl        String?
  teacherFacebookUrl         String?
  teacherProfileImportConsent Boolean              @default(false)
  teacherResumeUrl           String?
  teacherResumeFileName      String?
  teacherResumeMimeType      String?
  teacherResumeText          String?
  selectedProfileKind        String?
  selectedProfileId          String?
  status                     PendingSignupStatus    @default(PENDING)
  verifiedAt                 DateTime?
  consumedAt                 DateTime?
  expiresAt                  DateTime
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  verificationTokens         EmailVerificationToken[]

  @@index([normalizedEmail])
  @@index([status])
}

model EmailVerificationToken {
  id              String        @id
  pendingSignupId String
  tokenHash       String        @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pendingSignup   PendingSignup @relation(fields: [pendingSignupId], references: [id], onDelete: Cascade)

  @@index([pendingSignupId])
  @@index([expiresAt])
}

model PendingUserEmailChange {
  id                 String   @id
  userId             String
  previousEmail      String
  nextEmail          String
  normalizedNextEmail String
  tokenHash          String   @unique
  expiresAt          DateTime
  consumedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([normalizedNextEmail])
  @@index([expiresAt])
}

model AdminContentSettings {
  id                  String   @id
  hiddenEventKeywords String[]
  hiddenJobKeywords   String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EventHost {
  id         String                @id
  name       String                @unique
  slug       String                @unique
  websiteUrl String?
  imageUrl   String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  events     TeacherUpcomingEvent[]
  followers  UserEventHostFollow[]
}

model UserTeacherFollow {
  id        String   @id
  userId    String
  teacherId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([userId, teacherId])
  @@index([userId])
  @@index([teacherId])
}

model UserTeacherHeart {
  id        String   @id
  userId    String
  teacherId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([userId, teacherId])
  @@index([userId])
  @@index([teacherId])
}

model UserEventHostFollow {
  id        String    @id
  userId    String
  hostId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  host      EventHost @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([userId, hostId])
  @@index([userId])
  @@index([hostId])
}

model TeacherStory {
  id        String         @id
  teacherId String
  title     String
  caption   String
  mediaUrl  String
  mediaType StoryMediaType
  sortOrder Int            @default(0)
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  teacher   Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherUpcomingEvent {
  id                   String    @id
  teacherId            String
  hostId               String?
  title                String
  /// Homepage / profile category (Workshop, Retreat, Community, …).
  eventType            String    @default("Workshop")
  hostName             String?
  address              String?
  eventTime            String?
  imageUrl             String?
  eventImage           Bytes?
  eventImageMimeType   String?
  eventUrl             String?
  eventDate            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  teacher              Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  host                 EventHost? @relation(fields: [hostId], references: [id], onDelete: SetNull)

  @@index([hostId])
  @@index([teacherId, eventDate])
}

model TeacherCalendarSession {
  id          String   @id
  teacherId   String
  offeringId  String
  title       String
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  sourceUrl   String?
  isBooked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, startsAt])
  @@index([teacherId, isBooked])
}

model TeachingHourCounter {
  id         String   @id
  teacherId  String
  category   String
  totalHours Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, category])
}

model TeacherCertificationSubmission {
  id             String                        @id
  teacherId      String
  credentialName String
  notes          String?
  /// Download URL — `/api/teacher-certification-submissions/:id/file` when stored in DB; legacy `/uploads/...` for older rows.
  fileUrl        String
  /// Stored bytes on serverless hosts (disk uploads do not persist); null for legacy disk-only rows.
  fileData       Bytes?
  fileName       String
  mimeType       String
  status         CertificationSubmissionStatus @default(PENDING)
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  teacher        Teacher                       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model CommunityDiscussion {
  id         String               @id
  authorName String
  authorRole DiscussionAuthorRole
  title      String
  body       String
  tags       String[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  replyCount Int                  @default(0)
}

model ContactInquiry {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}
