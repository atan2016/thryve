# Used by Prisma and the app. Copy this file to `.env` or `.env.local`.
# Prisma CLI loads `.env` only unless you use `npm run db:*` (loads both).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yoga_platform"
# Same DB without PgBouncer; required by Prisma when using Supabase pooler for DATABASE_URL. For local Postgres, match DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/yoga_platform"
SESSION_SECRET="replace-this-with-a-long-random-string"
# Public origin (no trailing slash). In production set to your real HTTPS URL — required for verification emails and Stripe return URLs. Vercel sets VERCEL_URL as a fallback when this is unset.
APP_BASE_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
# Optional: display name in inbox (RFC From header).
SMTP_FROM_NAME=""
# Optional: Reply-To address (does not change SMTP auth alignment).
SMTP_REPLY_TO=""
# Optional: override recipient for “new certification submitted” admin alerts (default ashleyt@gmail.com).
CERTIFICATION_NOTIFY_EMAIL=""
# Optional: max size in bytes for teacher upcoming event images stored in the database (default 5242880 = 5MB).
EVENT_IMAGE_MAX_BYTES=""
# Optional: Adzuna Jobs API (https://developer.adzuna.com/). When ADZUNA_APP_ID and ADZUNA_APP_KEY are set, the homepage
# “New Jobs of the Week” carousel loads live listings (wellness / yoga / pilates–filtered) instead of an empty list.
# Without those keys, the carousel is empty unless USE_MOCK_JOBS is enabled for local demos.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Two-letter country code for the Adzuna jobs endpoint (default us).
ADZUNA_COUNTRY_CODE=""
# Optional: narrow results to a city or region (Adzuna “where” parameter), e.g. San Francisco Bay Area.
ADZUNA_WHERE=""
# Optional: cache TTL for the job search response in seconds (default 3600, min 60, max 86400).
ADZUNA_CACHE_REVALIDATE_SECONDS=""
# Set to "true" to show built-in sample job cards when Adzuna credentials are not configured (local demos only).
USE_MOCK_JOBS=""
