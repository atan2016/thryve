{
  "name": "thryve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prisma-with-env.cjs generate",
    "dev": "next dev",
    "build": "node scripts/prisma-with-env.cjs generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-with-env.cjs generate",
    "db:migrate": "node scripts/prisma-with-env.cjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-with-env.cjs migrate dev",
    "db:push": "node scripts/prisma-with-env.cjs db push",
    "db:seed": "node scripts/prisma-with-env.cjs db seed",
    "db:restore:k-j-robin": "node scripts/restore-kj-robin-teachers.cjs",
    "schedules:scrape:blu-robin": "node scripts/scrape-sync-blu-robin-schedules.cjs",
    "schedules:scrape:blu-robin:dry": "node scripts/scrape-sync-blu-robin-schedules.cjs --dry-run"
  },
  "dependencies": {
    "@prisma/client": "6.16.0",
    "bcryptjs": "latest",
    "date-fns": "latest",
    "jose": "latest",
    "next": "latest",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "prisma": "6.16.0",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "dotenv": "^17.4.2",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
